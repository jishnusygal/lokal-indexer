# Copy this file to .env and set a strong private password.
LOKAL_ADMIN_PASSWORD=replace-with-a-strong-password
# Internal Docker URL used by Prowlarr, Sonarr, and Radarr. Do not use the public domain.
LOKAL_INTERNAL_URL=http://lokal-indexer
# Optional fixed URL. Leave unset to resolve URLs from each incoming request.
# LOKAL_PUBLIC_URL=https://your-indexer-host.example
